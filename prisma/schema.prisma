// Schema Prisma - Plateforme de faire-part de mariage
// Base : PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================
// ENUMS
// =====================================================

enum Role {
  CUSTOMER
  ADMIN
}

enum WeddingStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EventType {
  CEREMONY
  RECEPTION
  OTHER
}

enum RsvpResponse {
  YES
  NO
  MAYBE
}

enum PlanTier {
  ESSENTIEL
  PREMIUM
  PRESTIGE
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  INITIATED
  SUCCESS
  FAILED
  REFUNDED
}

enum ShareChannel {
  WHATSAPP
  LINK
  QRCODE
  FACEBOOK
  OTHER
}

// =====================================================
// UTILISATEUR
// =====================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String
  role          Role      @default(CUSTOMER)
  phone         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  weddings Wedding[]
  orders   Order[]

  @@index([email])
}

// =====================================================
// MARIAGE
// =====================================================

model Wedding {
  id          String        @id @default(cuid())
  slug        String        @unique
  partnerOne  String
  partnerTwo  String
  weddingDate DateTime
  weddingTime String? // ex "16:00"
  message     String?
  contactPhone String?
  status      WeddingStatus @default(DRAFT)
  planTier    PlanTier      @default(ESSENTIEL)

  // SEO / partage
  coverImageUrl String?
  seoDescription String?

  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId String?
  template   WeddingTemplate? @relation(fields: [templateId], references: [id])

  events      WeddingEvent[]
  photos      WeddingPhoto[]
  guests      Guest[]
  orders      Order[]
  shareEvents ShareEvent[]

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([userId])
  @@index([weddingDate])
  @@index([status])
}

// =====================================================
// EVENEMENT (ceremonie / reception)
// =====================================================

model WeddingEvent {
  id        String    @id @default(cuid())
  weddingId String
  wedding   Wedding   @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  type      EventType @default(CEREMONY)
  title     String
  venueName String
  address   String?
  latitude  Float?
  longitude Float?
  mapUrl    String?
  startsAt  DateTime?
  notes     String?
  sortOrder Int       @default(0)

  createdAt DateTime  @default(now())

  @@index([weddingId])
}

// =====================================================
// PHOTO
// =====================================================

model WeddingPhoto {
  id           String  @id @default(cuid())
  weddingId    String
  wedding      Wedding @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  storageKey   String
  url          String
  thumbnailUrl String?
  width        Int?
  height       Int?
  mimeType     String?
  size         Int?
  sortOrder    Int     @default(0)
  isCover      Boolean @default(false)

  createdAt    DateTime @default(now())

  @@index([weddingId])
}

// =====================================================
// TEMPLATE
// =====================================================

model WeddingTemplate {
  id          String    @id @default(cuid())
  key         String    @unique // ex "classic", "minimal"
  name        String
  description String?
  style       String? // texte de presentation
  previewUrl  String?
  minTier     PlanTier  @default(ESSENTIEL) // offre minimale requise
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)

  weddings Wedding[]

  createdAt DateTime @default(now())
}

// =====================================================
// INVITE / RSVP
// =====================================================

model Guest {
  id        String       @id @default(cuid())
  weddingId String
  wedding   Wedding      @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  name      String
  phone     String?
  response  RsvpResponse @default(YES)
  partySize Int          @default(1)
  message   String?

  createdAt DateTime @default(now())

  @@index([weddingId])
}

// =====================================================
// COMMANDE
// =====================================================

model Order {
  id        String      @id @default(cuid())
  weddingId String?
  wedding   Wedding?    @relation(fields: [weddingId], references: [id])
  userId    String
  user      User        @relation(fields: [userId], references: [id])

  planTier  PlanTier
  amount    Int // en centimes / plus petite unite (XOF: unite entiere)
  currency  String      @default("XOF")
  status    OrderStatus @default(PENDING)

  payments  Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([weddingId])
}

// =====================================================
// PAIEMENT
// =====================================================

model Payment {
  id           String        @id @default(cuid())
  orderId      String
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  provider     String // ex "wave", "orange-money", "stripe"
  providerRef  String?
  amount       Int
  currency     String        @default("XOF")
  status       PaymentStatus @default(INITIATED)
  rawPayload   Json?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([orderId])
}

// =====================================================
// EVENEMENT DE PARTAGE (analytics)
// =====================================================

model ShareEvent {
  id        String       @id @default(cuid())
  weddingId String
  wedding   Wedding      @relation(fields: [weddingId], references: [id], onDelete: Cascade)

  channel   ShareChannel
  createdAt DateTime     @default(now())

  @@index([weddingId])
}
