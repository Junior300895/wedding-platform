# Modele de configuration : copier en .env.local et renseigner les valeurs.
# Ne jamais committer de vraies valeurs dans ce fichier.

# ==============================
# Base de donnees
# ==============================
# MySQL 8 (en local via WAMP : port 3306)
DATABASE_URL="mysql://UTILISATEUR:MOTDEPASSE@localhost:3306/wedding_platform"

# ==============================
# Application
# ==============================
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==============================
# Authentification (Auth.js v5)
# Generer un secret : npx auth secret
# ==============================
AUTH_SECRET=""

# ==============================
# Stockage des photos
# ==============================
# "local"      : fichiers dans /public/uploads (developpement uniquement)
# "cloudinary" : obligatoire en production (Vercel a un disque en lecture seule)
#
# Les photos deja envoyees en local restent affichees et supprimables
# apres le passage a Cloudinary.
STORAGE_PROVIDER="local"

# Tableau de bord Cloudinary > Settings > API Keys
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ==============================
# Paiement (phase ulterieure)
# ==============================
PAYMENT_SECRET=""
